# Generate with: openssl rand -base64 32, and prefix it with base64:
APP_KEY=
MQTT_USER=bridge
# 31 characters at most: the board truncates longer ones.
MQTT_PASSWORD=
# 1-9999, same as "Relay Password" on the board. 0 means no password.
DTR008_RELAY_PASSWORD=
# Address of the PC on the board's LAN. 127.0.0.1 is enough for the simulator.
BROKER_BIND_IP=127.0.0.1
# Real board: /dingtian/relay followed by the serial (Head slash on).
DTR008_TOPIC_PREFIX=/dingtian/relay00000
# false hides the simulator and starts the bridge on the real board.
SIMULATOR_ENABLED=true
